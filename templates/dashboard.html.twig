{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body_class %}bg-info-subtle dashboard-page{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/dashboard.css">
{% endblock %}

{% block body %}
    

    <main class="container-fluid px-4 py-4">
        <div class="text-center mb-4">
            <h1 class="display-6 fw-bold text-dark">FICHIER DES ASSURÉS</h1>
            <p class="text-muted">Recherche et consultation rapide des assurés</p>
        </div>

        <div class="mx-auto mb-4" style="max-width: 980px;">
        <section class="card shadow-lg border-0 rounded-4">
            <div class="card-body">
                {# Le formulaire envoie une requête HTTP GET vers la route nommée "dashboard". Symfony construit l'adresse exacte de cette route grâce à path('dashboard').
                Cette route vient du contrôleur : src/Controller/AssuresController.php, ligne avec #[Route('/dashboard', name: 'dashboard')]. Donc path('dashboard') génère l'adresse exacte /dashboard automatiquement. #}
                <form class="row g-3" method="GET" action="{{ path('dashboard') }}">
                    <div class="col-md-4">
                        <label class="form-label">NIR</label>
                        {# inspecte le paramètre GET 'nir' de la requête HTTP courante et le réinjecte dans le champ. #}
                        <input type="text" class="form-control" name="nir" value="{{ app.request.query.get('nir', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">NIR (BNF)</label>
                        {#  inspecte le paramètre GET 'nirBnf' depuis l'adresse exacte /dashboard?nirBnf=... de la requête HTTP. #}
                        <input type="text" class="form-control" name="nirBnf" value="{{ app.request.query.get('nirBnf', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date de traitement</label>
                        {# inspecte le paramètre GET 'dateTraitement' depuis la requête. #}
                        <input type="text" class="form-control" name="dateTraitement" value="{{ app.request.query.get('dateTraitement', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Prénom</label>
                        {# inspecte le paramètre GET 'prenom' depuis l'adresse exacte /dashboard?prenom=... de la requête HTTP. #}
                        <input type="text" class="form-control" name="prenom" value="{{ app.request.query.get('prenom', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nom</label>
                        {# inspecte le paramètre GET 'nom' depuis la requête courante. #}
                        <input type="text" class="form-control" name="nom" value="{{ app.request.query.get('nom', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date de naissance</label>
                        {# inspecte le paramètre GET 'dateNaissance' depuis l'adresse exacte /dashboard?dateNaissance=... #}
                        <input type="text" class="form-control" name="dateNaissance" value="{{ app.request.query.get('dateNaissance', '') }}">
                    </div>
                    
                    {# <div class="col-md-4">
                        <label class="form-label">Numéro compostage</label>
                        <input type="text" class="form-control" name="macben" value="{{ app.request.query.get('macben', '') }}">
                    </div> #}
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Rechercher</button>
                        <a href="{{ path('dashboard') }}" class="btn btn-outline-secondary">Réinitialiser</a>
                    </div>
                </form>
            </div>
        </section>
        </div>

        <section class="card shadow-lg border-0 rounded-4" style="margin-left: 10px; margin-right: 10px;">
            <div class="card-body p-0">
                <div class="table-responsive shadow-sm">
                    <table class="table table-hover align-middle mb-0" id="resultats">
                        <thead class="table-primary">
                            <tr>
                                <th>NIR</th>
                                <th>NIR (BNF)</th>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Date naissance</th>
                                <th>Adresse</th>
                                <th>Date de traitement</th>
                            </tr>
                        </thead>
                        <tbody id="corpsTableau">
                        {% for a in Assures %}
                        <tr>
                            <td>{{ a.nir }}</td>
                            <td>{{ a.nirBnf }}</td>
                            <td>{{ a.nom }}</td>
                            <td>{{ a.prenom }}</td>
                            <td>{{ a.dateNaissance ?: '' }}</td>
                            <td>{{ a.adresseComplete }}</td>
                            <td>{{ a.dateTraitement ?: '' }}</td>
                        </tr>
                        {% else %}
                            <tr><td colspan="7" class="text-center py-4">Aucun résultat</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
