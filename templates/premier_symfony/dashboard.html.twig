<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <!-- Lien vers le CSS de Bootstrap pour les styles -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/CSS/dashboard.css">
    <!-- script de Bootstrap pour les fonctionnalités JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <!-- Lien pour les icônes Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body class="bg-info-subtle">
    <nav class="navbar navbar-light bg-white shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="/images/logo.jpg" alt="Logo" width="75" height="75" class="d-inline-block align-top logo-dashboard">
            </a>
            <div class="d-flex align-items-center gap-4">
                <div class="nav-item">
                    <a class="nav-link text-dark fw-semibold" href="#">Accueil</a>
                </div>
                <div class="nav-item">
                    <a class="nav-link text-dark fw-semibold" href="#">Calcul Clé NIR</a>
                </div>
                <div class="nav-item d-flex align-items-center gap-2">
                    <a class="nav-link text-dark fw-semibold" href="#"><i class="bi bi-person-fill icone-profil"></i> {{ user.nomPrenom }}</a>
                </div>
                <div class="nav-item">
                    <a class="nav-link text-dark" href="{{ path('app_assures_logout') }}" title="Déconnexion">
                        <i class="bi bi-power icone-power"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container-fluid px-4 py-4">
        <div class="text-center mb-4">
            <h1 class="display-6 fw-bold text-dark">FICHIER DES ASSURÉS</h1>
            <p class="text-muted">Recherche et consultation rapide des assurés</p>
        </div>

        <section class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <form class="row g-3" method="GET" action="{{ path('dashBoard') }}">
                    <div class="col-md-4">
                        <label class="form-label">NIR</label>
                        <input type="text" class="form-control" name="nir" value="{{ app.request.query.get('nir', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">NIR (BNF)</label>
                        <input type="text" class="form-control" name="nirBnf" value="{{ app.request.query.get('nirBnf', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date de traitement</label>
                        <input type="text" class="form-control" name="dateTraitement" value="{{ app.request.query.get('dateTraitement', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Prénom</label>
                        <input type="text" class="form-control" name="prenom" value="{{ app.request.query.get('prenom', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nom</label>
                        <input type="text" class="form-control" name="nom" value="{{ app.request.query.get('nom', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date de naissance</label>
                        <input type="text" class="form-control" name="dateNaissance" value="{{ app.request.query.get('dateNaissance', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Numéro compostage</label>
                        <input type="text" class="form-control" name="macben" value="{{ app.request.query.get('macben', '') }}">
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Rechercher</button>
                        <a href="{{ path('dashBoard') }}" class="btn btn-outline-secondary">Réinitialiser</a>
                    </div>
                </form>
            </div>
        </section>

        <section class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="resultats">
                        <thead class="table-primary">
                            <tr>
                                <th>NIR</th>
                                <th>NIR (BNF)</th>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Date naissance</th>
                                <th>Adresse</th>
                                <th>Date de traitement</th>
                            </tr>
                        </thead>
                        <tbody id="corpsTableau">
                        {% for a in Assures %}
                        <tr>
                            <td>{{ a.nir }}</td>
                            <td>{{ a.nirBnf }}</td>
                            <td>{{ a.nom }}</td>
                            <td>{{ a.prenom }}</td>
                            <td>{{ a.dateNaissance ?: '' }}</td>
                            <td>{{ a.adresseComplete }}</td>
                            <td>{{ a.dateTraitement ?: '' }}</td>
                        </tr>
                        {% else %}
                            <tr><td colspan="7" class="text-center py-4">Aucun résultat</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
</body>

</html>
