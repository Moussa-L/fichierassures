<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <!-- Lien vers le CSS de Bootstrap pour les styles -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/CSS/dashboard.css">
    <!-- script de Bootstrap pour les fonctionnalités JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <!-- Lien pour les icônes Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body> 

    <nav class="navbar navbar-light bg-white" >
        <a class="navbar-brand" href="#">
            
            <img src="/images/logo.jpg" alt="Logo" width="75" height="75" class="d-inline-block align-top logo-dashboard">
        </a>
        <a href="#">Accueil</a>
        <a href="#">Calcul Clé NIR</a>
        <a href="#" ><i class="bi bi-person-fill icone-profil"></i> {{ user.nomPrenom }}</a>
        <i class="bi bi-power text-dark icone-power" id="bouttonDeco"></i>
    </nav>

    <!--Titre de la page-->
        <h1 class="titre-dashboard">FICHIER DES ASSURES</h1>
        
    <!--Formulaire-->

    <form class="formulaire" >

    <div class="colonne marge-colonne">
        <input type="text" placeholder="NIR :">
        <input type="text" placeholder="NUM COMPOSTAGE :">
        <input type="text" placeholder="DATE DE TRAITEMENT:">
    </div>

    <div class="colonne">
        <input type="text" placeholder="PRÉNOM :">
        <input type="text" placeholder="NOM :">
    </div>

    <div class="colonne marge-colonne">
        <input type="texte" placeholder="DATE DE NAISSANCE :">
        <input type="text" placeholder="NIR (BNF):">
    </div>

    



    </form>


    
    <table id="resultats">

        <thead>
            <tr>
                <th>NIR</th>
                <th>NIR (BNF)</th>
                <th>Nom, Prénom</th>
                <th>Date naissance</th>
                <th>Lieu de naissance</th>
                <th>addresse Complete</th>
                <th>Date de traitement</th>
            </tr>
        </thead>


        <tbody id="corpsTableau">
        {% for a in Assures %}
        <tr>
            <td>{{ a.nir }}</td>
            <td>{{ a.nirBnf }}</td>
            <td>{{ a.nom ~ ' ' ~ a.prenom }}</td>
            <td>{{ a.dateNaissance ?: '' }}</td>
            <td>{{ a.Cmmune_drg }}</td>
            <td>{{ a.adresseComplete }}</td>
            <td>{{ a.dateTraitement ?: '' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="7">Aucun résultat</td></tr>
        {% endfor %}
        </tbody>


    </table>

    

</body>

</html>
