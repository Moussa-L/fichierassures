<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <!-- Lien vers le CSS de Bootstrap pour les styles -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/CSS/dashboard.css">
    <!-- script de Bootstrap pour les fonctionnalités JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <!-- Lien pour les icônes Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body class="bg-info-subtle">
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand me-3 d-flex align-items-center" href="#">
                <img src="/images/logo.jpg" alt="Logo" width="72" height="72" class="rounded-circle shadow-sm">
                <div class="palette ms-3 d-none d-md-inline-flex" aria-label="Palette logo">
                    <span class="palette-dot" title="Couleur 1"></span>
                    <span class="palette-dot" title="Couleur 2"></span>
                    <span class="palette-dot" title="Couleur 3"></span>
                    <span class="palette-dot" title="Couleur 4"></span>
                    <span class="palette-dot" title="Couleur 5"></span>
                    <span class="palette-dot" title="Couleur 6"></span>
                </div>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarDashboard" aria-controls="navbarDashboard" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarDashboard">
                <ul class="navbar-nav align-items-lg-center gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold text-dark" href="#">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold text-dark" href="#">Calcul Clé NIR</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link fw-semibold text-dark d-flex align-items-center dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i> {{ user.nomPrenom }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Profil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid px-4 py-4">
        <div class="text-center mb-4">
            <h1 class="display-6 fw-bold text-dark">FICHIER DES ASSURÉS</h1>
            <p class="text-muted">Recherche et consultation rapide des assurés</p>
        </div>

        <section class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <form class="row g-3" method="GET" action="{{ path('dashBoard') }}">
                    <div class="col-md-4">
                        <label class="form-label">NIR</label>
                        <input type="text" class="form-control" name="nir" value="{{ app.request.query.get('nir', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">NIR (BNF)</label>
                        <input type="text" class="form-control" name="nirBnf" value="{{ app.request.query.get('nirBnf', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date de traitement</label>
                        <input type="text" class="form-control" name="dateTraitement" value="{{ app.request.query.get('dateTraitement', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Prénom</label>
                        <input type="text" class="form-control" name="prenom" value="{{ app.request.query.get('prenom', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nom</label>
                        <input type="text" class="form-control" name="nom" value="{{ app.request.query.get('nom', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date de naissance</label>
                        <input type="text" class="form-control" name="dateNaissance" value="{{ app.request.query.get('dateNaissance', '') }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Numéro compostage</label>
                        <input type="text" class="form-control" name="macben" value="{{ app.request.query.get('macben', '') }}">
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Rechercher</button>
                        <a href="{{ path('dashBoard') }}" class="btn btn-outline-secondary">Réinitialiser</a>
                    </div>
                </form>
            </div>
        </section>

        <section class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="resultats">
                        <thead class="table-primary">
                            <tr>
                                <th>NIR</th>
                                <th>NIR (BNF)</th>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Date naissance</th>
                                <th>Adresse</th>
                                <th>Date de traitement</th>
                            </tr>
                        </thead>
                        <tbody id="corpsTableau">
                        {% for a in Assures %}
                        <tr>
                            <td>{{ a.nir }}</td>
                            <td>{{ a.nirBnf }}</td>
                            <td>{{ a.nom }}</td>
                            <td>{{ a.prenom }}</td>
                            <td>{{ a.dateNaissance ?: '' }}</td>
                            <td>{{ a.adresseComplete }}</td>
                            <td>{{ a.dateTraitement ?: '' }}</td>
                        </tr>
                        {% else %}
                        <tr><td colspan="7" class="text-center py-4">Aucun résultat</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
</body>

</html>
