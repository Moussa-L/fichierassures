        <input type="text" placeholder="NOM :" style="border-radius: 9px;">
    </div>

    <div class="colonne" style="margin: 5px;">
        <input type="number" placeholder="DATE DE NAISSANCE :" style="border-radius: 9px;">
        <input type="text" placeholder="NIR (BNF):" style="border-radius: 9px;">
    </div>

    



    </form>


    
    <table id="resultats">

        <thead>
            <tr>
