<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Connexion</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('CSS/login.css') }}">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>

    <body class="login-body">
        <div class="login-page">
            <div class="text-center mt-5">
                <h1 class="welcome-title">Bienvenue</h1>
                <h3>dans l'application web Fichier des Assurés</h3>
            </div>

            <main class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-5">

                        <h1 class="text-center mb-4">Connexion</h1>

                        <form class="card p-4 shadow-sm">
                    <div class="mb-3">
                        <label for="numberGRF" class="form-label">Numéro GRH</label>
                        <!--inputmode, c'est pour les claviers numériques sur les téléphones. Et pattern, c'est pour le nombre de saisie-->
                        <input id="numberGRF" type="text" inputmode="numeric" pattern="[0-5]*" name="numberGRF" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input id="password" type="password" name="password" class="form-control">
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Se connecter
                    </button>
                </form>

                    </div>
                </div>
            </main>
        </div>

</body>
</html>
