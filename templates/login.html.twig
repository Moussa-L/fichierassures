<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Connexion</title>
    <link rel="icon" type="image/png" href="{{ asset('images/CSSM PETALES.png') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>

    <body style="margin: 0; min-height: 100vh; background-image: url('{{ asset('images/CSSM PETALES.png') }}'); background-size: 1200px; background-position: unset; background-repeat: no-repeat;">

       

        <div class="min-vh-100 d-flex flex-column justify-content-center" style="padding-top: 5px; margin-top: -25px;">

            <div class="ensembleElem">

                <div class="text-center px-3" style="margin-top: -170px;">
                    <h1 class="mb-2">Caisse de Sécurité Sociale de Mayotte</h1>
                    <h3>Bienvenue dans Fichier des Assurés</h3>
                </div>

                <main class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-5">
                        <h1 class="text-center mb-4">Connexion</h1>

                        <form class="card p-4 shadow-sm" method="post" action="{{ path('app_assures_login') }}">
                            {% if error %}
                                <div class="alert alert-danger" role="alert">
                                    {{ error }}
                                </div>
                            {% endif %}

                            <div class="mb-3">
                                <label for="login" class="form-label">Identifiant </label>
                                <input id="login" type="text" name="login" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Mot de passe</label>
                                <input id="password" type="password" name="password" class="form-control" required>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                Se connecter
                            </button>
                        </form>
                    </div>
                </div>
                </main>
            </div>
        </div>
    </body>
</html>
