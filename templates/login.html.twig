<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Connexion</title>
    <link rel="icon" type="image/png" href="{{ asset('images/CSSM PETALES.png') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>

    <body style="margin: 0; min-height: 100vh; background-image: url('{{ asset('images/CSSM PETALES.png') }}'); background-size: 830px; background-position: left 320px; background-repeat: no-repeat;">

       

        <div class="min-vh-100 d-flex flex-column justify-content-center" style="padding-top: 5px; margin-top: -25px;">

           

               

                <main class="container mt-5">
                
                <div class="row justify-content-center classEnsemb">
                 <h3 class="classP1">Bienvenue dans Fichier des Assurés</h3>
                    <div class="col-md-5 classTransForm">
                       
                            <img src="{{ asset('images/Logo-CSSM.png') }}" alt="Logo CSSM" width="250" height="120" class="logoCssm">
                            
                        
                        <h1 class="text-center classP2 mb-4 login-title">Connexion</h1>

                        <form class="card p-4 shadow-sm login-card glass-panel classFormId" method="post" action="{{ path('app_assures_login') }}">
                            {% if error %}
                                <div class="alert alert-danger" role="alert">
                                    {{ error }}
                                </div>
                            {% endif %}

                            <div class="mb-3">
                                <label for="login" class="form-label">Identifiant </label>
                                <input id="login" type="text" name="login" class="form-control ClassInput" required>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Mot de passe</label>
                                <input id="password" type="password" name="password" class="form-control ClassInput" required>
      
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                Se connecter
                            </button>
                        </form>
                    </div>
                </div>
                </main>
            </div>
        
    </body>
</html>
